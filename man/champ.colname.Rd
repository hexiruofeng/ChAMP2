\name{champ.colname}
\alias{champ.colname}
\title{Rename the columns of a beta matrix with Sample_Name}
\usage{
champ.colname(beta, pd)
}
\arguments{
  \item{beta}{beta value matrix.}
  \item{pd}{sample sheet containing Sample_Name.}
}
\description{Rename the columns of a beta matrix with Sample_Name}
\value{the beta matrix with renamed columns.}
\seealso{\code{\link{champ.process}}, \code{\link{champ_check_env}}}
\keyword{methods}
